    "\n",
    "scores_map_situacao_norm = {\n",
    "    str(k).strip().lower(): int(v) for k, v in scores_map_situacao.items()\n",
    "}\n",
    "# summary table (value, frequency, score)\n",
    "summary_situacao = (\n",
    "    pd.DataFrame({\"valor\": uniq, \"freq\": freq.values})\n",
    "      .assign(score=lambda df: df[\"valor\"].map(scores_map_situacao_norm).astype(\"Int64\"))\n",
    "      .sort_values([\"freq\",\"valor\"], ascending=[False, True])\n",
    "      .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "pd.set_option(\"display.max_rows\", None)\n",
    "display(summary_situacao) \n",
    "\n",
    "data[target] = s.map(scores_map_situacao_norm).fillna(0).astype(\"Int64\")"
   ]
