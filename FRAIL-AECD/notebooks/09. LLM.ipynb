    "# Configuração do LLM (Ollama + Qwen3)\n",
    "OLLAMA_URL = \"http://localhost:11434/api/chat\"\n",
    "MODEL_ID   = \"qwen2.5:7b-instruct\" "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "7ed653d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Funções para chamar o LLM e interpretar a resposta\n",
    "def ask_llm(text: str, prompt, few) -> str:\n",
    "    payload = {\n",
    "        \"model\": MODEL_ID,\n",
    "        \"messages\": [{\"role\":\"system\",\"content\":prompt}] + few + [{\"role\":\"user\",\"content\": text}],\n",
    "        \"stream\": False,\n",
    "        \"format\": \"json\",\n",
    "        \"options\": {\"temperature\": 0.0, \"num_predict\": 16}\n",
    "    }\n",
    "    r = requests.post(OLLAMA_URL, json=payload, timeout=120)\n",
    "    r.raise_for_status()\n",
    "    # print(r.json())  # ver done_reason e tokens gerados\n",
    "\n",
    "    return r.json()[\"message\"][\"content\"]  # ex: {\"score\": 2}\n",
    "\n",
    "def parse_score(resp: str) -> int:\n",
    "    try:\n",
    "        return int(json.loads(resp).get(\"score\", 0))\n",
    "    except Exception:\n",
    "        m = re.search(r\"\\b([0-9]|10)\\b\", str(resp))\n",
    "        return int(m.group(1)) if m else 0"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "556eb628",
   "metadata": {},
   "source": [
    "Agora definimos o prompt e os exemplos few shot para a coluna em questão"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "e913fe12",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Input: hematoma\n",
      "Response: {\"score\": 2}\n",
      "Score: 2\n"
     ]
    }
   ],
   "source": [
    "# Prompt para o LLM\n",
    "SYSTEM = (\n",
    "    \"És um assistente clínico. Atribui uma gravidade 0–10 à lesão descrita.\\n\"\n",
    "    \"0–2: ligeiro; 3–5: moderado; 6–8: grave; 9–10: muito grave.\\n\"\n",
    "    \"Responde APENAS com JSON válido exatamente {\\\"score\\\": <int 0-10>}. Sem texto extra.\"\n",
    ")\n",
    "\n",
    "# Exemplos de Lesões e respectivas gravidades (few shot learning)\n",
    "FEW_SHOTS = [\n",
    "    {\"role\": \"user\", \"content\": \"Não sabe\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 0}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Arranhão\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 1}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Hematoma\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 2}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Entorse ligeira\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 3}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Fratura do braço\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 5}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Luxacao\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 6}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Traumatismo craniano\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 8}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"AVC\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 9}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Enfarte\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 10}\"},\n",
    "]\n",
    "\n",
    "# Teste\n",
    "test_input = \"hematoma\"\n",
    "response = ask_llm(test_input, SYSTEM, FEW_SHOTS)\n",
    "score = parse_score(response)\n",
    "print(f\"Input: {test_input}\\nResponse: {response}\\nScore: {score}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b5fe9d69",
   "metadata": {},
   "source": [
    "Podemos então testar todas as linhas unicas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "479fc4e3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Normalizar e obter únicos ordenados \n",
    "s = (data[col].fillna(\"\").astype(str).str.strip().str.lower())\n",
    "uniq = sorted(t for t in s.unique() if t != \"\")\n",
    "\n",
    "# dar score para cada valor único (uma vez só)\n",
    "scores_map = {t: parse_score(ask_llm(t, SYSTEM, FEW_SHOTS)) for t in uniq}\n",
    "\n",
    "# garantir que o mapa tem a mesma normalização\n",
    "scores_map_norm = {\n",
    "    str(k).strip().lower(): int(v) for k, v in scores_map.items()\n",
    "}\n",
    "\n",
    "# aplicar\n",
    "data[target] = s.map(scores_map_norm).fillna(0).astype(\"Int64\")"
   ]
  },
