    "# === Prompt & few-shots ===\n",
    "SYSTEM = (\n",
    "    \"És um assistente clínico. Atribui uma gravidade 0–10 ao LOCAL da lesão descrito.\\n\"\n",
    "    \"0–2: ligeiro; 3–5: moderado; 6–8: grave; 9–10: muito grave.\\n\"\n",
    "    \"Responde APENAS no formato JSON: {\\\"score\\\": X}.\"\n",
    ")\n",
    "\n",
    "FEW_SHOTS = [\n",
    "    {\"role\": \"user\", \"content\": \"Não sabe\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 0}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Dedo da mão\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 2}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Mão\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 3}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Tornozelo\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 3}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Braço\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 3}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Ombro\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 4}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Coxa\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 5}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Costelas\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 5}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Anca\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 6}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Cabeça\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 8}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Pescoço\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 7}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Coluna cervical\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 9}\"},\n",
    "]\n",
    "\n",
    "# Normalize text & unique list\n",
    "s = data[col].fillna(\"\").astype(str).str.strip()\n",
    "uniq = sorted(t for t in s.unique() if t != \"\")\n",
    "\n",
    "# Score each unique value once via LLM\n",
    "scores_map = {t: parse_score(ask_llm(t, SYSTEM, FEW_SHOTS)) for t in uniq}\n",
    "\n",
    "# 3) Map back to full dataset (empty -> 0)\n",
    "data[target] = s.map(scores_map).fillna(0).astype(\"Int64\")\n",
    "\n",
    "# 4) Summary table (value, score, frequency)\n",
    "summary = (\n",
    "    pd.DataFrame({\"valor\": uniq})\n",
    "      .assign(\n",
    "          score=lambda df_: df_[\"valor\"].map(scores_map).astype(\"Int64\"),\n",
    "          freq=lambda df_: df_[\"valor\"].map(s.value_counts()).fillna(0).astype(int)\n",
    "      )\n",
    "      .sort_values([\"freq\", \"valor\"], ascending=[False, True])\n",
    "      .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "display(summary.head(50))  \n",
    "# display(data[[col, target]].head(50))  # peek per-row"
   ]
