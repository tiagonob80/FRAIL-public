   "source": [
    "# Prompt para o LLM\n",
    "SYSTEM = (\n",
    "    \"Classifica cenários de quedas segundo uma escala clínica de gravidade (0–10).\\n\"\n",
    "    \"\\nPrincípio central:\\n\"\n",
    "    \"- Quanto mais básica for a atividade em que ocorre a queda (ex.: caminhar, levantar-se, estar parado), \"\n",
    "    \"mais GRAVE é, porque revela maior fragilidade e vulnerabilidade.\\n\"\n",
    "    \"- Quanto mais COMPLEXA ou EXIGENTE for a atividade (ex.: subir escadote, apanhar fruta numa árvore, ginástica, bicicleta), \"\n",
    "    \"menos grave é, porque envolve esforço adicional e risco ambiental, e não necessariamente fragilidade clínica.\\n\"\n",
    "    \"- Situações ligadas a SINTOMAS MÉDICOS (ex.: tontura, desmaio, AVC, quebra de tensão) são as mais graves de todas, \"\n",
    "    \"porque a causa é patológica.\\n\"\n",
    "    \"\\nEscala:\\n\"\n",
    "    \"0–2: ligeiro → quedas em atividades complexas de risco ambiental.\\n\"\n",
    "    \"3–5: moderado → tropeçar, escorregar, correr, subir/descer escadas.\\n\"\n",
    "    \"6–8: grave → quedas em atividades básicas (caminhar, levantar-se, estar parado/em pé, cama, banho, tarefas domésticas).\\n\"\n",
    "    \"9–10: muito grave → quedas associadas a sintomas médicos (desmaio, tontura, AVC, quebra de tensão).\\n\"\n",
    "    \"\\nFormato de saída:\\n\"\n",
    "    \"{'score': <0-10>,}\"\n",
    ")\n",
    "\n",
    "\n",
    "FEW_SHOTS = [\n",
    "    {\"role\": \"user\", \"content\": \"apanhar fruta numa árvore\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 1}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"subir um escadote\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 2}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"correr\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 3}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"tropeçar\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 4}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Descer escadas\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 5}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"caminhar\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 6}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"sentar-se numa cadeira\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 7}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Atividades domesticas\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 8}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"banho\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 9}\"},\n",
    "\n",
    "    {\"role\": \"user\", \"content\": \"Queda após AVC/desmaio/tontura\"},\n",
    "    {\"role\": \"assistant\", \"content\": \"{\\\"score\\\": 10}\"},\n",
    "]\n",
    "\n",
    "# Teste\n",
    "print(parse_score(ask_llm(\"correr\", SYSTEM, FEW_SHOTS)))"
   ]
