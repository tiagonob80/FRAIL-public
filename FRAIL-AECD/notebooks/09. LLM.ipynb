   "source": [
    "col    = \"@6_MIN_ANDAR_Parou_Motivo\"\n",
    "target = \"@6_MIN_ANDAR_Parou_Motivo_score\"\n",
    "\n",
    "# normalizar\n",
    "s = data[col].fillna(\"\").astype(str).str.strip().str.lower()\n",
    "freq = s[s != \"\"].value_counts()\n",
    "uniq = freq.index.tolist()\n",
    "\n",
    "print(f\"Unique non-empty values: {len(uniq)}\")\n",
    "\n",
    "scores_map_parou = {t: parse_score(ask_llm(t, SYSTEM, FEW_SHOTS)) for t in uniq}\n",
    "\n",
    "scores_map_parou_norm = {\n",
    "    str(k).strip().lower(): int(v) for k, v in scores_map_parou.items()\n",
    "}\n",
    "\n",
    "# tabela resumo (valor, frequência, score)\n",
    "summary_parou = (\n",
    "    pd.DataFrame({\"valor\": uniq, \"freq\": freq.values})\n",
    "      .assign(score=lambda df: df[\"valor\"].map(scores_map_parou_norm).astype(\"Int64\"))\n",
    "      .sort_values([\"freq\",\"valor\"], ascending=[False, True])\n",
    "      .reset_index(drop=True)\n",
    ")\n",
    "pd.set_option(\"display.max_rows\", None)\n",
    "\n",
    "display(summary_parou)\n",
    "data[target] = s.map(scores_map_parou_norm).fillna(0).astype(\"Int64\")"
   ]
  },
